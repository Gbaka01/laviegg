Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Fichiers ou dossiers réels : servis tels quels
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fichier statique absent (.js, .css, .png…) : vraie 404
  RewriteRule \.[a-zA-Z0-9]{2,5}$ - [R=404,L]

  # Toutes les autres routes (/document, etc.) : passées à React
  RewriteRule ^ index.html [L]
</IfModule>